# Publication boundary: retain project-made Animator Controllers and their GUIDs.
# Raw models, clips, textures and imported materials are not approved for sharing.
/Assets/Monster/*
!/Assets/Monster/Monster Animator Controller.controller
!/Assets/Monster/Monster Animator Controller.controller.meta
/Assets/Player/*
!/Assets/Player/Player Animator Controller.controller
!/Assets/Player/Player Animator Controller.controller.meta

# Unverified third-party door bundle, monster materials and sounds.
/Assets/Doors/
/Assets/Doors.meta
/Assets/Materials/Ch10_1001_Diffuse.mat
/Assets/Materials/Ch10_1001_Diffuse.mat.meta
/Assets/Materials/Ch10_1002_Diffuse.mat
/Assets/Materials/Ch10_1002_Diffuse.mat.meta
/Assets/Sounds/
/Assets/Sounds.meta

# Original archives, private copies and course submission reports are not uploads.
/*.zip
/*.ppt
/*.pptx
/*_PRIVATE/
/publication_reference/
/publication_audit/

# No global *.meta / *.asset exclusion: retain scene GUIDs, baked NavMesh,
# scripts, prefabs, Animator Controllers, CC0 textures and the OFL font + notice.
